# ============================================================
# 元素幻语 · 环境变量模板
# 使用方法：复制本文件为 .env，替换其中的占位值为真实密钥
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env
# .env 已被 .gitignore 忽略，不会进入公开仓库
# ============================================================

# ---------- 大语言模型（DeepSeek） ----------
# 申请地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# ---------- 语音合成（阿里云 DashScope / CosyVoice） ----------
# 申请地址：https://bailian.console.aliyun.com/
TTS_API_KEY=your_dashscope_api_key_here
TTS_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
TTS_MODEL=cosyvoice-v3-flash
TTS_VOICE=longxiaochun_v3
TTS_FORMAT=mp3
TTS_SAMPLE_RATE=22050

# ---------- 视觉识别（通义千问 VL，桌宠子项目 AIgent 使用） ----------
VISION_API_KEY=your_dashscope_api_key_here
VISION_MODEL_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
VISION_MODEL_NAME=qwen3-vl-plus
